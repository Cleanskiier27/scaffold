# .env.example — copy to .env and fill in your values.
# Never commit .env to version control.
# All variables here are required unless marked OPTIONAL.

# ── Application ──────────────────────────────────────────────
PROJECT_ENV=development       # development | staging | production | test
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Security ─────────────────────────────────────────────────
SECRET_KEY=replace-me-with-a-long-random-string-at-least-32-chars

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/project_dev
DB_POOL_SIZE=10               # OPTIONAL — default: 10
DB_POOL_TIMEOUT=30            # OPTIONAL — default: 30

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0                  # OPTIONAL — default: 0.0.0.0
PORT=8080                     # OPTIONAL — default: 8080
