# EditorConfig — https://editorconfig.org
# Ensures consistent coding styles across editors and IDEs.
# Most editors support this natively or via a plugin.

root = true

# ─────────────────────────────────────────────
# Global defaults (all files)
# ─────────────────────────────────────────────
[*]
charset                  = utf-8
end_of_line              = lf
indent_style             = space
indent_size              = 2
insert_final_newline     = true
trim_trailing_whitespace = true
max_line_length          = 100

# ─────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────
[*.py]
indent_size    = 4
max_line_length = 88   # Black default

# ─────────────────────────────────────────────
# Go
# ─────────────────────────────────────────────
[*.go]
indent_style = tab
indent_size  = 4

# ─────────────────────────────────────────────
# Rust
# ─────────────────────────────────────────────
[*.rs]
indent_size = 4

# ─────────────────────────────────────────────
# Markdown — preserve trailing spaces (line breaks)
# ─────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false
max_line_length          = off

# ─────────────────────────────────────────────
# YAML
# ─────────────────────────────────────────────
[*.{yml,yaml}]
indent_size = 2

# ─────────────────────────────────────────────
# JSON / JSONC
# ─────────────────────────────────────────────
[*.{json,jsonc}]
indent_size = 2

# ─────────────────────────────────────────────
# TOML
# ─────────────────────────────────────────────
[*.toml]
indent_size = 2

# ─────────────────────────────────────────────
# Makefiles — tabs are required
# ─────────────────────────────────────────────
[Makefile]
indent_style = tab

# ─────────────────────────────────────────────
# Shell scripts
# ─────────────────────────────────────────────
[*.{sh,bash,zsh}]
indent_size = 2

# ─────────────────────────────────────────────
# Dockerfiles
# ─────────────────────────────────────────────
[Dockerfile*]
indent_size = 4
